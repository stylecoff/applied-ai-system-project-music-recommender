flowchart TD
    A["Streamlit app (app.py): user enters a 4-letter MBTI code"] --> G1{"Guardrail: valid code?"}
    G1 -- "no" --> ERR["Reject with clear error"]
    G1 -- "yes" --> CODE["Valid code, for example INFP"]

    subgraph PAIRS["Four preference pairs: the letters build the taste profile"]
        IE["E / I: where energy goes<br/>I calmer and quieter, E livelier and louder"]
        SN["S / N: how information is taken in<br/>S grounded and acoustic, N dreamy and electronic"]
        TF["T / F: how decisions are made<br/>T focused and cooler, F warm and emotional"]
        JP["J / P: how life is organized<br/>J steady tempo, P spontaneous and faster"]
    end

    CODE --> IE
    CODE --> SN
    CODE --> TF
    CODE --> JP

    IE --> GENRE["Genre from I/E + S/N: IN indie pop, IS lofi, EN pop, ES rock"]
    SN --> GENRE
    IE --> MOOD["Mood from I/E + T/F: IT focused, IF nostalgic, ET intense, EF happy"]
    TF --> MOOD
    IE --> NUM["Numeric targets: energy, danceability, acousticness, valence, tempo"]
    SN --> NUM
    TF --> NUM
    JP --> NUM
    GENRE --> PROFILE["Taste profile"]
    MOOD --> PROFILE
    NUM --> PROFILE

    CODE --> TYPEINFO["Type lookup: 16 types in 4 families, name and family are display labels only. See diagrams/mbti_types.mmd"]
    TYPEINFO --> EXPL["Explainer panel: what MBTI is, plus the type name, family and description"]

    HIST[("Top tracks snapshot from Receiptify, not live Spotify")] --> BL["Blend with listening history, if the user picks songs"]
    PROFILE --> BL

    CSV[("songs.csv: 75 songs, hand-estimated features")] --> SCORE
    BL --> SCORE["score_song: genre and mood match plus closeness on numeric features"]
    SCORE --> RANK["recommend_songs: rank the whole catalog with reasons"]
    RANK --> DIV["Mix it up (optional toggle): max 2 songs per genre in the top K"]

    DIV --> CONF["Confidence score: MBTI-only is low, with history is higher"]
    DIV --> BIAS["Bias check: warn if one genre dominates the top K"]
    DIV --> LISTEN["Playback: iTunes 30-second preview in the app, plus YouTube and Spotify links"]

    subgraph RAG["Gemini assistant with retrieval"]
        ASK["User asks a question (empty rejected, cut at 300 characters)"]
        RET["Retrieve: top 10 songs, taste profile, MBTI explainer text"]
        GEM["Gemini API: answers using only the retrieved context"]
        VER["Verification: every song named must be one of the retrieved songs"]
    end

    ASK --> RET
    DIV --> RET
    EXPL --> RET
    RET --> GEM
    GEM --> VER
    VER -- "unknown song or Gemini error" --> FALL["Fallback: show catalog-only answer and log the error"]
    VER -- "all songs valid" --> ANS["Assistant answer"]

    CONF --> OUT["Output: songs, reasons, confidence, warnings, previews, assistant answer"]
    BIAS --> OUT
    LISTEN --> OUT
    ANS --> OUT
    FALL --> OUT
    OUT --> HITL["Human in the loop: user edits a letter or history and re-runs"]
    HITL -.-> A

    TESTS["Reliability: pytest on validation, scoring, ranking, answer verification, plus src/evaluate.py on all 16 types"] -.-> G1
    TESTS -.-> SCORE
    TESTS -.-> RANK
    TESTS -.-> VER

    classDef built fill:#d4edda,stroke:#2e7d32,color:#000
    class A,G1,ERR,CODE,IE,SN,TF,JP,GENRE,MOOD,NUM,PROFILE,TYPEINFO,EXPL,HIST,BL,CSV,SCORE,RANK,DIV,CONF,BIAS,LISTEN,ASK,RET,GEM,VER,FALL,ANS,OUT,HITL,TESTS built